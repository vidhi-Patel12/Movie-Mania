@page "/Languages/Edit"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAntiforgery Antiforgery
@inject IConfiguration _configuration

@using Microsoft.AspNetCore.Antiforgery;
<PageTitle>Languages</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Edit Language</h2>
                    </div>
                    @if (Languages is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-4">
                                <EditForm method="post" Model="Languages" OnValidSubmit="UpdateLanguages" FormName="Edit" Enhance>
                                    <DataAnnotationsValidator />
                                    <input type="hidden" name="Languages.LanguageId" value="@Languages.LanguageId" />
                                    <div class="mb-3">
                                        <label for="languagename" class="form-label text-black">Language Name:</label>
                                        <InputText id="languagename" @bind-Value="Languages.LanguageName" class="form-control" />
                                        <ValidationMessage For="() => Languages.LanguageName" class="text-danger" />
                                    </div>
                                    <input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
                                    <div class="mb-3">
                                        <input type="hidden" id="createdby" value="Languages.CreatedBy" class="form-control" />
                                    </div>
                                    <div class="mb-3">
                                        <input type="hidden" id="createddatetime" value="Languages.CreatedDateTime" class="form-control" />
                                    </div>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </EditForm>
                            </div>
                        </div>
                    }
                    <br />
                    <div>
                        <a href="/Languages">Back to List</a>
                    </div>
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private int LanguageId { get; set; }

    [SupplyParameterFromForm]
    private Languages? Languages { get; set; }

    private string? LoggedInUser;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Languages ??= await context.Languages.FirstOrDefaultAsync(m => m.LanguageId == LanguageId);

        if (Languages is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task UpdateLanguages()
    {
        using var context = DbFactory.CreateDbContext();

        LoggedInUser = _configuration["LoggedInUserId"];

        if (string.IsNullOrEmpty(LoggedInUser))
        {
            // Handle case where UserId cookie is not present
            Console.WriteLine("UserId cookie not found.");
            return;
        }

        var existingLanguage = await context.Languages
        .AsNoTracking()
        .FirstOrDefaultAsync(lang => lang.LanguageId == Languages.LanguageId);

        if (existingLanguage == null)
        {
            // Handle case where the language does not exist
            Console.WriteLine($"Language with ID {Languages.LanguageId} not found.");
            NavigationManager.NavigateTo("notfound");
            return;
        }

        // Preserve the original CreatedBy and CreatedDateTime values
        Languages.CreatedBy = existingLanguage.CreatedBy;
        Languages.CreatedDateTime = existingLanguage.CreatedDateTime;

        // Set the necessary properties for update
        Languages.IsActive = true;
        Languages.UpdatedBy = LoggedInUser;
        Languages.UpdatedDateTime = DateTime.Now;

        context.Attach(Languages!).State = EntityState.Modified;
        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!LanguagesExists(Languages!.LanguageId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
        NavigationManager.NavigateTo("/Languages");
    }

    private bool LanguagesExists(int languageid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Languages.Any(e => e.LanguageId == languageid);
    }
}
