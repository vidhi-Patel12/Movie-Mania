@page "/Movie"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MovieMania.Models
@using MovieMania.Data
@using System.Text.Json

@rendermode @(new InteractiveServerRenderMode(false))

@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject IConfiguration _configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Movie</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Movie</h2>
                    </div>
                    <div class="row">
                        <div class="col-6"></div>
                        <div class="col-4 text-end">
                            <InputText type="search" @bind-value="nameFilter" placeholder="Search" style="height:37px;" @oninput="DebouncedHandleSearch" />
                        </div>
                        <p class="col-2">
                            <a class="btn btn-primary" href="Movie/Create">Create New</a>
                        </p>
                    </div>

                    <QuickGrid TItem="Movie" Class="table table-striped" Items="@filteredMovie.AsQueryable()" Pagination="@pageDetails">

                        <TemplateColumn Context="movie" Title="Movie Name">
                            <p>@CapitalizeFirstLetter(movie.MovieName)</p>
                        </TemplateColumn>                      

                        <TemplateColumn Context="movie" Title="Cinema">
                            <p>@GetCinemaName(movie.MovieId)</p>
                        </TemplateColumn>

                        <TemplateColumn Context="movie" Title="Genre">
                            <p>@GetGenresName(movie.MovieId)</p>
                        </TemplateColumn>

                        <TemplateColumn Context="movie" Title="Language">
                            <p>@GetLanguageName(movie.MovieId)</p>
                        </TemplateColumn>

                        <TemplateColumn Context="movie" Title="Format">
                            <p>@GetFormatName(movie.MovieId)</p>
                        </TemplateColumn>
                        <TemplateColumn Context="movie" Title="Movie Rate">
                            <p>@movie.MovieRating</p>
                        </TemplateColumn>

                        <TemplateColumn Context="movie" Title="Action">
                            <a href="@($"Movie/Details?movieid={movie.MovieId}")"><i class="bi bi-eye-fill" style="color:#29b474"></i></a> &nbsp;
                            @if (movie.CreatedBy == LoggedInUser)
                            {
                                <a href="@($"Movie/Edit?movieid={movie.MovieId}")"><i class="bi bi-pencil-fill" style="color:#2f80ed"></i></a>
                                <span>&nbsp;</span>
                                <a href="/Movie" @onclick="() => OpenDeleteModal(movie.MovieId)">
                                    <i class="bi bi-trash-fill" style="color:#eb5757"></i>
                                </a>
                            }
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="@pageDetails" />
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Movie Delete</h5>
                <br />
                <p class="text-md-center">Are you sure you want to permanently delete this movie?</p>
                <br />
                <div class="row">
                    <div class="col-4"></div>
                    <div class="col-5">
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>&nbsp;
                        <button type="button" class="btn btn-secondary" @onclick="() => showModal = false">Cancel</button>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Movie" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Movie" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    string nameFilter = "";
    List<Movies> filteredMovie = new List<Movies>();
    PaginationState pageDetails = new PaginationState { ItemsPerPage = 10 };
    private System.Timers.Timer? debounceTimer;

    private bool showModal = false;
    private int? selectedMovieId;

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private bool ShowSuccessModal { get; set; } = false;
    private string? SId;
    private string? LoggedInUser;

    private Dictionary<int, List<string>> movieCinemaLookup = new();
    private Dictionary<int, List<string>> movieGenreLookup = new();
    private Dictionary<int, List<string>> movieLanguageLookup = new();
    private Dictionary<int, List<string>> movieFormatLookup = new();

    protected override async Task OnInitializedAsync()
    {
        await HandleSearch();
        await LoadLookups();
    }

    private void DebouncedHandleSearch(ChangeEventArgs e)
    {
        nameFilter = e.Value?.ToString();

        // Reset the timer
        debounceTimer?.Stop();
        debounceTimer = new System.Timers.Timer(100); // 100ms debounce
        debounceTimer.Elapsed += async (_, _) => await InvokeAsync(HandleSearch);
        debounceTimer.Start();
    }

    private async Task HandleSearch()
    {
        debounceTimer?.Stop();
        var context = DbFactory.CreateDbContext();
        if (!string.IsNullOrWhiteSpace(nameFilter))
        {
            filteredMovie = await context.Movies
                                        .Where(x => EF.Functions.Like(
                                            EF.Functions.Collate(x.MovieName, "SQL_Latin1_General_CP1_CI_AS"),
                                            $"%{nameFilter}%"))
                                        .ToListAsync();
        }
        else
        {
            SId = _configuration["SId"];
            LoggedInUser = _configuration["LoggedInUserId"];
            
            if (LoggedInUser == SId)
            {
                filteredMovie = await context.Movies
                                        .Where(X => X.CreatedBy == SId && X.IsActive == true)
                                        .OrderByDescending(x => x.MovieId)
                                        .ToListAsync();
            }
            else
            {
                filteredMovie = await context.Movies
                     .Where(x => (x.CreatedBy == SId || x.CreatedBy == LoggedInUser) && x.IsActive == true)
                    .OrderByDescending(x => x.MovieId)
                    .ToListAsync();
            }
        }
    }

    private async Task LoadLookups()
    {
        using var context = DbFactory.CreateDbContext();

        // Load Movie-Cinema Mapping
        movieCinemaLookup = await context.MovieCinema
            .Include(mc => mc.Cinema)
            .GroupBy(mc => mc.MovieId)
            .ToDictionaryAsync(g => g.Key, g => g.Select(mc => mc.Cinema.CinemaName).ToList());

        // Load Movie-Genre Mapping
        movieGenreLookup = await context.MovieGenre
            .Include(mg => mg.Genre)
            .GroupBy(mg => mg.MovieId)
            .ToDictionaryAsync(g => g.Key, g => g.Select(mg => mg.Genre.GenresName).ToList());

        // Load Movie-Language Mapping
        movieLanguageLookup = await context.MovieLanguage
            .Include(ml => ml.Language)
            .GroupBy(ml => ml.MovieId)
            .ToDictionaryAsync(g => g.Key, g => g.Select(ml => ml.Language.LanguageName).ToList());

        // Load Movie-Format Mapping
        movieFormatLookup = await context.MovieFormat
            .Include(mf => mf.Format)
            .GroupBy(mf => mf.MovieId)
            .ToDictionaryAsync(g => g.Key, g => g.Select(mf => mf.Format.FormatName).ToList());
    }
        
    private MarkupString GetCinemaName(int movieId)
    {
        if (!movieCinemaLookup.TryGetValue(movieId, out var cinemas) || cinemas.Count == 0)
            return new MarkupString("N/A");

        string formattedCinemas = string.Join(", ", cinemas
            .Select((cinemas, index) => (index + 1) % 3 == 0 ? cinemas + "<br />" : cinemas));

        return new MarkupString(formattedCinemas);
    }
   
    private MarkupString GetGenresName(int movieId)
    {
        if (!movieGenreLookup.TryGetValue(movieId, out var genres) || genres.Count == 0)
            return new MarkupString("N/A");

        string formattedGenres = string.Join(", ", genres
            .Select((genre, index) => (index + 1) % 3 == 0 ? genre + "<br />" : genre));

        return new MarkupString(formattedGenres);
    }

    private MarkupString GetLanguageName(int movieId)
    {
        if (!movieLanguageLookup.TryGetValue(movieId, out var languages) || languages.Count == 0)
            return new MarkupString("N/A");

                string formattedLanguages = string.Join(", ", languages
            .Select((lang, index) => (index + 1) % 3 == 0 ? lang + "<br />" : lang));

        return new MarkupString(formattedLanguages);
    }

    private MarkupString GetFormatName(int movieId)
    {
        if (!movieFormatLookup.TryGetValue(movieId, out var formats) || formats.Count == 0)
            return new MarkupString("N/A");
            
        string formattedFormats = string.Join(", ", formats
            .Select((format, index) => (index + 1) % 3 == 0 ? format + "<br />" : format));

        return new MarkupString(formattedFormats);
    }

    public string CapitalizeFirstLetter(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return input;
        }

        return char.ToUpper(input[0]) + input.Substring(1).ToLower();
    }

    private void OpenDeleteModal(int movieId)
    {       
        selectedMovieId = movieId;
        showModal = true;
    }

    private void ConfirmDelete()
    {
        if (selectedMovieId != null)
        {
            DeleteMovie(selectedMovieId.Value);
            showModal = false;
        }
    }

    private async Task DeleteMovie(int movieId)
    {
        using var context = DbFactory.CreateDbContext();

        if (string.IsNullOrEmpty(LoggedInUser))
        {
            Console.WriteLine("UserId cookie not found.");
            return;
        }

        // Find the Movie by ID
        var movie = await context.Movies.FirstOrDefaultAsync(m => m.MovieId == movieId);

        if (movie == null)
        {
            Console.WriteLine($"Movie with ID {movieId} not found.");
            return;
        }

        // Delete the movie image from the file system
        if (!string.IsNullOrEmpty(movie.MovieImage))
        {
            var imageFileName = Path.GetFileName(movie.MovieImage);

            // Build the correct absolute path
            var movieImagePath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", imageFileName);
            Console.WriteLine($"Checking file path: {movieImagePath}");

            // Ensure file exists before trying to delete
            if (File.Exists(movieImagePath))
            {
                try
                {
                    Console.WriteLine("File exists. Deleting...");
                    File.Delete(movieImagePath);
                    Console.WriteLine("File deleted successfully.");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error deleting file: {ex.Message}");
                }
            }
            else
            {
                Console.WriteLine("File does not exist.");
            }
        }

        movie.IsActive = false;
        movie.UpdatedBy = LoggedInUser;
        movie.UpdatedDateTime = DateTime.Now;

        // Mark entity as modified
        context.Attach(movie).State = EntityState.Modified;

        var existingCinemas = await context.MovieCinema.Where(mc => mc.MovieId == movieId).ToListAsync();
        foreach (var cinema in existingCinemas)
        {
            cinema.IsActive = false;
            cinema.UpdatedBy = LoggedInUser;
            cinema.UpdatedDateTime = DateTime.Now;
            context.MovieCinema.Update(cinema);
        }

        // **Update Movie-Genre Mapping**
        var existingGenres = await context.MovieGenre.Where(mg => mg.MovieId == movieId).ToListAsync();
        foreach (var genre in existingGenres)
        {
            genre.IsActive = false; // Changed from `true` to `false`
            genre.UpdatedBy = LoggedInUser;
            genre.UpdatedDateTime = DateTime.Now;
            context.MovieGenre.Update(genre);
        }

        // **Update Movie-Language Mapping**
        var existingLanguages = await context.MovieLanguage.Where(ml => ml.MovieId == movieId).ToListAsync();
        foreach (var language in existingLanguages)
        {
            language.IsActive = false;
            language.UpdatedBy = LoggedInUser;
            language.UpdatedDateTime = DateTime.Now;
            context.MovieLanguage.Update(language);
        }

        // **Update Movie-Format Mapping**
        var existingFormats = await context.MovieFormat.Where(mf => mf.MovieId == movieId).ToListAsync();
        foreach (var format in existingFormats)
        {
            format.IsActive = false;
            format.UpdatedBy = LoggedInUser;
            format.UpdatedDateTime = DateTime.Now;
            context.MovieFormat.Update(format);
        }

        try
        {
            await context.SaveChangesAsync();
            showModal = false;
            await HandleSearch();
            StateHasChanged();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!MovieExists(movie.MovieId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/Movie");
    }

    private bool MovieExists(int movieId)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Movies.Any(e => e.MovieId == movieId);
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        StateHasChanged();
    }
}