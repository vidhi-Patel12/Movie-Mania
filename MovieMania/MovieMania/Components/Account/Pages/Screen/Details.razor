@page "/Screen/Details"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Screen</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Screen Detail</h2>
                    </div>
                    @if (screen is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <dl class="row  text-black">
                            <dt class="col-sm-2">Screen Name</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(screen.ScreenName)</dd>
                        </dl>
                        <dl class="row text-black">
                            <dt class="col-sm-2">Cinema</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(cinemaName)</dd>
                        </dl>
                       
                        <dl class="row  text-black">
                            <dt class="col-sm-2">Total Seats</dt>
                            <dd class="col-sm-10">@screen.TotalSeats</dd>
                        </dl>
                        <div>
                            <a href="@($"/screen/edit?screenid={screen.ScreenId}")">Edit</a> |
                            <a href="@($"/Screen")">Back to List</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    private Screen? screen;

    [SupplyParameterFromQuery]
    private int ScreenId { get; set; }

    private string cinemaName = string.Empty;
   
    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        screen = await context.Screen.FirstOrDefaultAsync(m => m.ScreenId == ScreenId);

        if (screen is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        var cinema = await context.Cinema.FirstOrDefaultAsync(c => c.CinemaId == screen.CinemaId);
      
        cinemaName = cinema?.CinemaName ?? "N/A";        
    }

    public string CapitalizeFirstLetter(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return input;
        }
        return char.ToUpper(input[0]) + input.Substring(1).ToLower();
    }
}
