@page "/SeatType/details"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IConfiguration _configuration

<PageTitle>SeatType</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Seat Type Detail</h2>
                    </div>
                    @if (seatType is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <dl class="row  text-black">
                            <dt class="col-sm-2">Seat Type Name</dt>
                            <dd class="col-sm-10">@seatType.SeatTypeName</dd>
                        </dl>
                        <div>
                            @if (seatType.CreatedBy == LoggedInUser)
                            {
                                <a href="@($"SeatType/edit?seatTypeid={seatType.SeatTypeId}")">Edit</a>
                            }
                           | <a href="@($"/SeatType")">Back to List</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    private SeatType? seatType;

    [SupplyParameterFromQuery]
    private int SeatTypeId { get; set; }

    private string? LoggedInUser;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        LoggedInUser = _configuration["LoggedInUserId"];
        seatType = await context.SeatType.FirstOrDefaultAsync(m => m.SeatTypeId == SeatTypeId);

        if (seatType is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
