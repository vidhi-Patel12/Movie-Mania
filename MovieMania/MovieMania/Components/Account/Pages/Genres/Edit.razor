@page "/genres/edit"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAntiforgery Antiforgery
@inject IConfiguration  _configuration

@using Microsoft.AspNetCore.Antiforgery;
<PageTitle>Genres</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Edit Language</h2>
                    </div>
                    @if (Genres is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-4">
                                <EditForm method="post" Model="Genres" OnValidSubmit="UpdateGenres" FormName="Edit" Enhance>
                                    <DataAnnotationsValidator />
                                    <input type="hidden" name="Genres.GenresId" value="@Genres.GenresId" />
                                    <div class="mb-3">
                                        <label for="genrename" class="form-label text-black">Genres Name:</label>
                                        <InputText id="genrename" @bind-Value="Genres.GenresName" class="form-control" />
                                        <ValidationMessage For="() => Genres.GenresName" class="text-danger" />
                                    </div>
                                    <input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
                                    <div class="mb-3">
                                        <input type="hidden" id="createdby" value="Genres.CreatedBy" class="form-control" />
                                    </div>
                                    <div class="mb-3">
                                        <input type="hidden" id="createddatetime" value="Genres.CreatedDateTime" class="form-control" />
                                    </div>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </EditForm>
                            </div>
                        </div>
                    }
                    <br />
                    <div>
                        <a href="/Genres">Back to List</a>
                    </div>
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private int GenresId { get; set; }

    [SupplyParameterFromForm]
    private Genres? Genres { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? LoggedInUser;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Genres ??= await context.Genres.FirstOrDefaultAsync(m => m.GenresId == GenresId);

        if (Genres is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task UpdateGenres()
    {
        using var context = DbFactory.CreateDbContext();

        LoggedInUser = _configuration["LoggedInUserId"];

        if (string.IsNullOrEmpty(LoggedInUser))
        {
            Console.WriteLine("UserId cookie not found.");
            return;
        }
        var existingGenre = await context.Genres
        .AsNoTracking()
        .FirstOrDefaultAsync(genre => genre.GenresId == Genres.GenresId);

        if (existingGenre == null)
        {
            Console.WriteLine($"Genre with ID {Genres.GenresId} not found.");
            NavigationManager.NavigateTo("notfound");
            return;
        }

        Genres.CreatedBy = existingGenre.CreatedBy;
        Genres.CreatedDateTime = existingGenre.CreatedDateTime;
        Genres.IsActive = true;
        Genres.UpdatedBy = LoggedInUser;
        Genres.UpdatedDateTime = DateTime.Now;

        context.Attach(Genres!).State = EntityState.Modified;
        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!GenresExists(Genres!.GenresId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
        NavigationManager.NavigateTo("/Genres");
    }

    private bool GenresExists(int genreid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Genres.Any(e => e.GenresId == genreid);
    }
}
