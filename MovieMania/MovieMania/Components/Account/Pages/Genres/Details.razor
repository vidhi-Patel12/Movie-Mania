@page "/genres/details"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Genres</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Genre Detail</h2>
                    </div>
                    @if (genres is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <dl class="row  text-black">
                            <dt class="col-sm-2">Genres Name</dt>
                            <dd class="col-sm-10">@genres.GenresName</dd>
                        </dl>
                        <div>
                            <a href="@($"/genres/edit?genresid={genres.GenresId}")">Edit</a> |
                            <a href="@($"/Genres")">Back to List</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    private Genres? genres;

    [SupplyParameterFromQuery]
    private int GenresId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        genres = await context.Genres.FirstOrDefaultAsync(m => m.GenresId == GenresId);

        if (genres is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
