@page "/country/details"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Country</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Country Detail</h2>
                    </div>
                    @if (country is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <dl class="row  text-black">
                            <dt class="col-sm-2">Country Name</dt>
                            <dd class="col-sm-10">@country.CountryName</dd>
                        </dl>
                        <div>
                            <a href="@($"/Country/Edit?countryid={country.CountryId}")">Edit</a> |
                            <a href="@($"/Country")">Back to List</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    private Country? country;

    [SupplyParameterFromQuery]
    private int CountryId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        country = await context.Country.FirstOrDefaultAsync(m => m.CountryId == CountryId);

        if (country is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
