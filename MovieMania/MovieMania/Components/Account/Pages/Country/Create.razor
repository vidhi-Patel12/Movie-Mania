@page "/Country/Create"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@using Microsoft.AspNetCore.Antiforgery
@using System.Text.Json
@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAntiforgery Antiforgery
@inject IdentityRedirectManager RedirectManager
@inject IConfiguration _configuration

<PageTitle>Country</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Add Country</h2>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <EditForm Model="Country" OnValidSubmit="FetchAndSaveCountryFromApi" FormName="create">
                                <DataAnnotationsValidator />
                                <div class="mb-3">
                                    <label for="countryname" class="form-label text-black">Country Name:</label>
                                    <InputText id="countryname" @bind-Value="Country.CountryName" class="form-control" />
                                    <ValidationMessage For="() => Country.CountryName" class="text-danger" />
                                </div>
                                <input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContextAccessor.HttpContext).RequestToken" />
                                <button type="submit" class="btn btn-primary">
                                    <span>Create</span>
                                </button>
                            </EditForm>
                        </div>
                    </div>
                    <br />
                    <div>
                        <a href="/Country">Back to List</a>
                    </div>
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Country" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Country" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromForm]
    private Country Country { get; set; } = new();

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private bool ShowSuccessModal { get; set; } = false;
    private string? SId;
    private string? LoggedInUser;

    private async Task FetchAndSaveCountryFromApi()
    {
        ErrorMessage = "";
        SuccessMessage = "";
        LoggedInUser = _configuration["LoggedInUserId"];

        try
        {
            using var context = DbFactory.CreateDbContext();
            using var httpClient = new HttpClient();

            SId = _configuration["SId"];

            var existingCountry = await context.Country.Where(X => X.CreatedBy == SId || X.CreatedBy == LoggedInUser)
                .FirstOrDefaultAsync(l => EF.Functions.Like(l.CountryName, Country.CountryName));

            if (existingCountry != null)
            {
                ErrorMessage = $"The country '{Country.CountryName}' already exists.";
                ShowErrorModal = true;
                return;
            }

            var newCountry = new Country
                {
                    CountryName = Country.CountryName,
                    CreatedBy = LoggedInUser,
                        CreatedDateTime = DateTime.Now,
                    UpdatedBy = null,
                    UpdatedDateTime = null,
                    IsActive = true
                };
            context.Country.Add(newCountry);
            await context.SaveChangesAsync();

            SuccessMessage = $"The country '{Country.CountryName}' has been added successfully.";
            ShowSuccessModal = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
            ShowErrorModal = true;
        }
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        StateHasChanged();
    }
}
