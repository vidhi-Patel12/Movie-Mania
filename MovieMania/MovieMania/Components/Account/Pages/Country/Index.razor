@page "/Country"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MovieMania.Models
@using MovieMania.Data
@using System.Text.Json

@rendermode @(new InteractiveServerRenderMode(false))

@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject IConfiguration _configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Country</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Country</h2>
                    </div>
                    <div class="row">
                        <div class="col-6"></div>
                        <div class="col-4 text-end">
                            <InputText type="search" @bind-value="nameFilter" placeholder="Search" style="height:37px;" @oninput="DebouncedHandleSearch" />
                        </div>
                        <p class="col-2">
                            <a class="btn btn-primary" href="Country/Create">Create New</a>
                        </p>
                    </div>

                    <QuickGrid TItem="Country" Class="table table-striped" Items="@filteredCountry.AsQueryable()" Pagination="@pageDetails">
                        <PropertyColumn Property="country => country.CountryName" Title="Country Name" Sortable="true" />
                        <TemplateColumn Context="country" Title="Action">
                            <a href="@($"country/details?countryid={country.CountryId}")"><i class="bi bi-eye-fill" style="color:#29b474"></i></a> &nbsp;
                            @if (country.CreatedBy == LoggedInUser)
                            {
                                <a href="@($"country/edit?countryid={country.CountryId}")"><i class="bi bi-pencil-fill" style="color:#2f80ed"></i></a>
                                <span>&nbsp;</span>
                                <a href="/Country" @onclick="() => OpenDeleteModal(country.CountryId)">
                                    <i class="bi bi-trash-fill" style="color:#eb5757"></i>
                                </a>
                            }
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="@pageDetails" />
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Country Delete</h5>
                <br />
                <p class="text-md-center">Are you sure you want to permanently delete this country?</p>
                <br />
                <div class="row">
                    <div class="col-4"></div>
                    <div class="col-5">
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>&nbsp;
                        <button type="button" class="btn btn-secondary" @onclick="() => showModal = false">Cancel</button>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Country" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Country" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    string nameFilter = "";
    List<Country> filteredCountry = new List<Country>();
    PaginationState pageDetails = new PaginationState { ItemsPerPage = 10 };
    private System.Timers.Timer? debounceTimer;

    private bool showModal = false;
    private int? selectedCountryId;

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private bool ShowSuccessModal { get; set; } = false;

    private string? SId;
    private string? LoggedInUser;

    private void DebouncedHandleSearch(ChangeEventArgs e)
    {
        nameFilter = e.Value?.ToString();

        // Reset the timer
        debounceTimer?.Stop();
        debounceTimer = new System.Timers.Timer(100); // 100ms debounce
        debounceTimer.Elapsed += async (_, _) => await InvokeAsync(HandleSearch);
        debounceTimer.Start();
    }

    private async Task HandleSearch()
    {
        debounceTimer?.Stop();
        var context = DbFactory.CreateDbContext();
        if (!string.IsNullOrWhiteSpace(nameFilter))
        {
            filteredCountry = await context.Country
                                        .Where(x => EF.Functions.Like(
                                            EF.Functions.Collate(x.CountryName, "SQL_Latin1_General_CP1_CI_AS"),
                                            $"%{nameFilter}%"))
                                        .ToListAsync();
        }
        else
        {
            SId = _configuration["SId"];
            LoggedInUser = _configuration["LoggedInUserId"];

            if (LoggedInUser == SId)
            {
                filteredCountry = await context.Country
                                        .Where(X => X.CreatedBy == SId && X.IsActive == true)
                                        .OrderByDescending(x => x.CountryId)
                                        .ToListAsync();
                // If filteredCountry is still empty (no data in the database), fetch from the API
                if (!filteredCountry.Any())
                {
                    using var httpClient = new HttpClient();

                    // Fetch data from API
                    var response = await httpClient.GetAsync("https://www.freetestapi.com/api/v1/countries");
                    response.EnsureSuccessStatusCode();

                    // Read the response content as a string
                    var jsonString = await response.Content.ReadAsStringAsync();
                    Console.WriteLine(jsonString); // Log the JSON response for debugging

                    // Parse the JSON string using JsonDocument
                    List<string> apiCountry = new();
                    using (var doc = JsonDocument.Parse(jsonString))
                    {
                        if (doc.RootElement.ValueKind == JsonValueKind.Array)
                        {
                            // Extract all country names from API response
                            foreach (var item in doc.RootElement.EnumerateArray())
                            {
                                var countryName = item.GetProperty("name").GetString();
                                if (!string.IsNullOrWhiteSpace(countryName))
                                {
                                    apiCountry.Add(countryName.ToLower());
                                }
                            }
                        }
                        else
                        {
                            // Handle error if the data format is incorrect
                            ErrorMessage = "Invalid data.";
                            ShowErrorModal = true;
                            return;
                        }
                    }

                    // Check if the country list is not empty after fetching the API data
                    if (apiCountry.Any())
                    {
                        // Check if the country already exist in the database
                        var existingCountry = await context.Country.Select(x => x.CountryName.ToLower()).ToListAsync();
                        var newCountry = apiCountry.Where(country => !existingCountry.Contains(country)).ToList();

                        // If there are new country, insert them into the database
                        if (newCountry.Any())
                        {
                            var countryToAdd = newCountry.Select(country => new Country
                                {
                                    CountryName = country,
                                    CreatedBy = LoggedInUser,
                                    CreatedDateTime = DateTime.Now,
                                    UpdatedBy = null,
                                    UpdatedDateTime = null,
                                    IsActive = true
                                }).ToList();

                            await context.Country.AddRangeAsync(countryToAdd);
                            await context.SaveChangesAsync();

                            // Reload the data from the database
                            filteredCountry = await context.Country
                                        .Where(X => X.CreatedBy == SId && X.IsActive == true)
                                        .OrderByDescending(x => x.CountryId)
                                        .ToListAsync();
                        }
                    }
                }
            }
            else
            {
                filteredCountry = await context.Country
                     .Where(x => (x.CreatedBy == SId || x.CreatedBy == LoggedInUser) && x.IsActive == true)
                    .OrderByDescending(x => x.CountryId)
                    .ToListAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await HandleSearch();
    }

    private void OpenDeleteModal(int countryId)
    {
        // Set the selected country ID and open the modal
        selectedCountryId = countryId;
        showModal = true;
    }

    private void ConfirmDelete()
    {
        if (selectedCountryId != null)
        {
            // Call your delete logic here
            DeleteCountry(selectedCountryId.Value);
            showModal = false;
        }
    }

    private async Task DeleteCountry(int countryId)
    {
        using var context = DbFactory.CreateDbContext();

        if (string.IsNullOrEmpty(LoggedInUser))
        {
            // Handle case where UserId cookie is not present
            Console.WriteLine("UserId cookie not found.");
            return;
        }

        // Find the country by ID
        var country = await context.Country.FirstOrDefaultAsync(lang => lang.CountryId == countryId);

        if (country == null)
        {
            // Handle case where the country does not exist
            Console.WriteLine($"Country with ID {countryId} not found.");
            return;
        }

        country.IsActive = false;
        country.UpdatedBy = LoggedInUser;
        country.UpdatedDateTime = DateTime.Now;

        context.Attach(country).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
            showModal = false;
            await HandleSearch();
            StateHasChanged();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!CountryExists(country.CountryId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
        NavigationManager.NavigateTo("/Country");
    }

    private bool CountryExists(int countryId)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Country.Any(e => e.CountryId == countryId);
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        StateHasChanged();
    }
}