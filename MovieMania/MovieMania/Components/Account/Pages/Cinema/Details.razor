@page "/cinema/details"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Cinema</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Cinema Detail</h2>
                    </div>
                    @if (cinema is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <dl class="row  text-black">
                            <dt class="col-sm-2">Cinema Name</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(cinema.CinemaName)</dd>
                        </dl>
                        <dl class="row text-black">
                            <dt class="col-sm-2">Country</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(countryName)</dd>
                        </dl>
                        <dl class="row text-black">
                            <dt class="col-sm-2">State</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(stateName)</dd>
                        </dl>
                        <dl class="row text-black">
                            <dt class="col-sm-2">City</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(cityName)</dd>
                        </dl>
                        <dl class="row  text-black">
                            <dt class="col-sm-2">Address</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(cinema.Address)</dd>
                        </dl>
                        <dl class="row  text-black">
                            <dt class="col-sm-2">PinCode</dt>
                            <dd class="col-sm-10">@cinema.Pincode</dd>
                        </dl>
                        <div>
                            <a href="@($"/cinema/edit?cinemaid={cinema.CinemaId}")">Edit</a> |
                            <a href="@($"/Cinema")">Back to List</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    private Cinema? cinema;

    [SupplyParameterFromQuery]
    private int CinemaId { get; set; }

    private string countryName = string.Empty;
    private string stateName = string.Empty;
    private string cityName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        cinema = await context.Cinema.FirstOrDefaultAsync(m => m.CinemaId == CinemaId);

        if (cinema is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        var country = await context.Country.FirstOrDefaultAsync(c => c.CountryId == cinema.CountryId);
        var state = await context.State.FirstOrDefaultAsync(s => s.StateId == cinema.StateId);
        var city = await context.City.FirstOrDefaultAsync(c => c.CityId == cinema.CityId);

        countryName = country?.CountryName ?? "N/A";
        stateName = state?.StateName ?? "N/A";
        cityName = city?.CityName ?? "N/A";
    }

    public string CapitalizeFirstLetter(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return input;
        }

        return char.ToUpper(input[0]) + input.Substring(1).ToLower();
    }
}
