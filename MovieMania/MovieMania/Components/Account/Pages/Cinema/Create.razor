@page "/Cinema/Create"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@using Microsoft.AspNetCore.Antiforgery
@using System.Text.Json
@using System.Globalization

@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAntiforgery Antiforgery
@inject IdentityRedirectManager RedirectManager
@inject IConfiguration _configuration

@rendermode @(new InteractiveServerRenderMode(false))

<PageTitle>Cinema</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Add Cinema</h2>
                    </div>
                    <EditForm Model="Cinema" OnValidSubmit="FetchAndSaveCinema" FormName="create">
                        <DataAnnotationsValidator />
                        <div class="row">
                            <div class="col-6">
                                <div class="col-mb-3">
                                    <label for="cinemaname" class="form-label text-black">Cinema Name</label>
                                    <InputText id="cinemaname" @bind-Value="Cinema.CinemaName" class="form-control" />
                                    <ValidationMessage For="() => Cinema.CinemaName" class="text-danger" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="col-mb-3">
                                    <div>
                                        <label for="countryid" class="form-label text-black">Country</label>
                                    </div>
                                    <InputSelect @bind-Value="Cinema.CountryId" class="form-control" @oninput="OnCountryChanged">
                                        <option value="" disabled selected>Select Country</option>
                                        @foreach (var country in Countries)
                                        {
                                            <option value="@country.CountryId">@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(country.CountryName.ToLower())</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => Cinema.CountryId" class="text-danger" />
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-6">
                                <div class="col-mb-3">
                                    <div>
                                        <label for="stateid" class="form-label text-black">State</label>
                                    </div>
                                    <InputSelect @bind-Value="Cinema.StateId" class="form-control" @oninput="OnStateChanged">
                                        <option value="" disabled selected>Select State</option>
                                        @foreach (var state in States)
                                        {
                                            <option value="@state.StateId">@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(state.StateName.ToLower())</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Cinema.StateId)" class="text-danger" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="col-mb-3">
                                    <div>
                                        <label for="cityid" class="form-label text-black">City</label>
                                    </div>
                                    <InputSelect @bind-Value="Cinema.CityId" class="form-control">
                                        <option value="" disabled selected>Select City</option>
                                        @foreach (var city in Cities)
                                        {
                                            <option value="@city.CityId">@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(city.CityName.ToLower())</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Cinema.CityId)" class="text-danger" />
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-6">
                                <div class="mb-3">
                                    <label for="address" class="form-label text-black">Address</label>
                                    <InputTextArea id="address" @bind-Value="Cinema.Address" class="form-control" />
                                    <ValidationMessage For="() => Cinema.Address" class="text-danger" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mb-3">
                                    <label for="pincode" class="form-label text-black">Pincode</label>
                                    <InputNumber id="pincode" @bind-Value="Cinema.Pincode" class="form-control" />
                                    <ValidationMessage For="() => Cinema.Pincode" class="text-danger" />
                                </div>
                            </div>
                        </div>
                        <input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContextAccessor.HttpContext).RequestToken" />
                        <div class="row">
                            <div class="col-6">
                                <button type="submit" class="btn btn-primary">
                                    <span>Create</span>
                                </button>
                                <div>
                                    <a href="/Cinema">Back to List</a>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                    <br />
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Cinema" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Cinema" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromForm]
    private Cinema Cinema { get; set; } = new();

    private List<Country> Countries { get; set; } = new();
    private List<State> States { get; set; } = new();
    private List<City> Cities { get; set; } = new();
    private string SelectedCountryName { get; set; } = string.Empty;
    private int selectedCountry;

    private string ErrorMessage { get; set; }
    private string SuccessMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private bool ShowSuccessModal { get; set; } = false;
    private string? SId;
    private string? LoggedInUser;

    protected override async Task OnInitializedAsync()
    {
        await LoadCountries();
    }

    private async Task LoadCountries()
    {
        using var context = DbFactory.CreateDbContext();
        Countries = await context.Country.ToListAsync();
    }

    private async Task OnCountryChanged(ChangeEventArgs e)
    {
        if (e.Value != null && int.TryParse(e.Value.ToString(), out var countryId))
        {
            Cinema.CountryId = countryId;
            await LoadStates(countryId);
        }
    }

    private async Task LoadStates(int countryId)
    {
        using var context = DbFactory.CreateDbContext();
        States = await context.State.Where(s => s.CountryId == countryId).ToListAsync();
        Cities.Clear();
        StateHasChanged();
    }

    private async Task OnStateChanged(ChangeEventArgs e)
    {
        if (e.Value != null && int.TryParse(e.Value.ToString(), out var stateId))
        {
            await LoadCities(stateId);
        }
    }

    private async Task LoadCities(int stateId)
    {
        using var context = DbFactory.CreateDbContext();
        Cities = await context.City.Where(c => c.StateId == stateId).ToListAsync();
        StateHasChanged();
    }

    private async Task FetchAndSaveCinema()
    {
        ErrorMessage = "";
        SuccessMessage = "";
        LoggedInUser = _configuration["LoggedInUserId"];

        try
        {
            using var context = DbFactory.CreateDbContext();
            using var httpClient = new HttpClient();

            SId = _configuration["SId"];
                       
            var existingCinema = await context.Cinema.Where(X => X.CreatedBy == SId || X.CreatedBy == LoggedInUser)
                .FirstOrDefaultAsync(l => EF.Functions.Like(l.CinemaName, Cinema.CinemaName));

            if (existingCinema != null)
            {
                ErrorMessage = $"The cinema '{Cinema.CinemaName}' already exists.";
                ShowErrorModal = true;
                return;
            }

            var newCinema = new Cinema
                {
                    CinemaName = Cinema.CinemaName,
                    CountryId = Cinema.CountryId,
                    StateId = Cinema.StateId,
                    CityId = Cinema.CityId,
                    Address = Cinema.Address,
                    Pincode = Cinema.Pincode,
                    CreatedBy = LoggedInUser,
                    CreatedDateTime = DateTime.Now,
                    UpdatedBy = null,
                    UpdatedDateTime = null,
                    IsActive = true
                };
            context.Cinema.Add(newCinema);
            await context.SaveChangesAsync();

            SuccessMessage = $"The cinema '{Cinema.CinemaName}' has been added successfully.";
            ShowSuccessModal = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
            ShowErrorModal = true;
        }
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        NavigationManager.NavigateTo("/Cinema");
    }
}