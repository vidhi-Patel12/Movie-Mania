@page "/formats/details"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Formats</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Format Detail</h2>
                    </div>
                    @if (formats is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <dl class="row  text-black">
                            <dt class="col-sm-2">Formats Name</dt>
                            <dd class="col-sm-10">@formats.FormatName</dd>
                        </dl>
                        <div>
                            <a href="@($"/formats/edit?formatsid={formats.FormatId}")">Edit</a> |
                            <a href="@($"/Formats")">Back to List</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    private Formats? formats;

    [SupplyParameterFromQuery]
    private int FormatsId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        formats = await context.Formats.FirstOrDefaultAsync(m => m.FormatId == FormatsId);

        if (formats is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
