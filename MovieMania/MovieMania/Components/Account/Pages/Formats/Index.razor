@page "/Formats"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MovieMania.Models
@using MovieMania.Data
@using System.Text.Json

@rendermode @(new InteractiveServerRenderMode(false))

@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject IConfiguration _configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Formats</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Formats</h2>
                    </div>
                    <div class="row">
                        <div class="col-6"></div>
                        <!-- Search Bar -->
                        <div class="col-4 text-end">
                            <InputText type="search" @bind-value="nameFilter" placeholder="Search" style="height:37px;" @oninput="DebouncedHandleSearch" />
                        </div>
                        <p class="col-2">
                            <a class="btn btn-primary" href="Formats/Create">Create New</a>
                        </p>
                    </div>

                    <!-- Table with QuickGrid -->
                    <QuickGrid TItem="Formats" Class="table table-striped" Items="@filteredFormats.AsQueryable()" Pagination="@pageDetails">
                        <PropertyColumn Property="formats => formats.FormatName" Title="Formats Name" Sortable="true" />
                        <TemplateColumn Context="formats" Title="Action">
                            <a href="@($"formats/details?formatsid={formats.FormatId}")"><i class="bi bi-eye-fill" style="color:#29b474"></i></a> &nbsp;
                            @if (formats.CreatedBy == LoggedInUser)
                            {
                                <a href="@($"formats/edit?formatsid={formats.FormatId}")"><i class="bi bi-pencil-fill" style="color:#2f80ed"></i></a>
                                <span>&nbsp;</span>
                                <a href="/Formats" @onclick="() => OpenDeleteModal(formats.FormatId)">
                                    <i class="bi bi-trash-fill" style="color:#eb5757"></i>
                                </a>
                            }
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="@pageDetails" />
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Formats Delete</h5>
                <br />
                <p class="text-md-center">Are you sure you want to permanently delete this format?</p>
                <br />
                <div class="row">
                    <div class="col-4"></div>
                    <div class="col-5">
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>&nbsp;
                        <button type="button" class="btn btn-secondary" @onclick="() => showModal = false">Cancel</button>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Formats" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/Formats" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    string nameFilter = "";
    List<Formats> filteredFormats = new List<Formats>();
    PaginationState pageDetails = new PaginationState { ItemsPerPage = 10 };
    private System.Timers.Timer debounceTimer;

    private bool showModal = false;
    private int? selectedFormatId;

    private string ErrorMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private string SuccessMessage { get; set; }
    private bool ShowSuccessModal { get; set; } = false;

    private string SId;
    private string LoggedInUser;

    private void DebouncedHandleSearch(ChangeEventArgs e)
    {
        nameFilter = e.Value?.ToString();

        // Reset the timer
        debounceTimer?.Stop();
        debounceTimer = new System.Timers.Timer(100); // 100ms debounce
        debounceTimer.Elapsed += async (_, _) => await InvokeAsync(HandleSearch);
        debounceTimer.Start();
    }

    private async Task HandleSearch()
    {
        debounceTimer?.Stop();
        var context = DbFactory.CreateDbContext();
        if (!string.IsNullOrWhiteSpace(nameFilter))
        {
            filteredFormats = await context.Formats
                                        .Where(x => EF.Functions.Like(
                                            EF.Functions.Collate(x.FormatName, "SQL_Latin1_General_CP1_CI_AS"),
                                            $"%{nameFilter}%"))
                                        .ToListAsync();
        }
        else
        {
            SId = _configuration["SId"];
            LoggedInUser = _configuration["LoggedInUserId"];

            //var LoggedInUser = HttpContextAccessor.HttpContext.Request.Cookies["UserId"];

            if (LoggedInUser == SId)
            {
                filteredFormats = await context.Formats
                                        .Where(X => X.CreatedBy == SId && X.IsActive == true)
                                        .OrderByDescending(x => x.FormatId)
                                        .ToListAsync();
            }
            else
            {
                filteredFormats = await context.Formats
                     .Where(x => (x.CreatedBy == SId || x.CreatedBy == LoggedInUser) && x.IsActive == true)
                    .OrderByDescending(x => x.FormatId)
                    .ToListAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await HandleSearch();
    }

    private void OpenDeleteModal(int formatId)
    {
        // Set the selected Format ID and open the modal
        selectedFormatId = formatId;
        showModal = true;
    }

    private void ConfirmDelete()
    {
        if (selectedFormatId != null)
        {
            // Call your delete logic here
            DeleteFormat(selectedFormatId.Value);
            showModal = false;
        }
    }

    private async Task DeleteFormat(int formatsId)
    {
        using var context = DbFactory.CreateDbContext();

        if (string.IsNullOrEmpty(LoggedInUser))
        {
            // Handle case where UserId cookie is not present
            Console.WriteLine("UserId cookie not found.");
            return;
        }

        // Find the Format by ID
        var format = await context.Formats.FirstOrDefaultAsync(format => format.FormatId == formatsId);

        if (format == null)
        {
            // Handle case where the Format does not exist
            Console.WriteLine($"Format with ID {formatsId} not found.");
            return;
        }

        format.IsActive = false;
        format.UpdatedBy = LoggedInUser;
        format.UpdatedDateTime = DateTime.Now;

        // Attach the entity and mark it as modified
        context.Attach(format).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
            showModal = false;
            await HandleSearch();
            StateHasChanged();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!FormatsExists(format.FormatId))
            {
                // Navigate to not found page if the Format does not exist
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
        NavigationManager.NavigateTo("/Formats");
    }

    private bool FormatsExists(int formatsId)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Formats.Any(e => e.FormatId == formatsId);
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        StateHasChanged();
    }
}