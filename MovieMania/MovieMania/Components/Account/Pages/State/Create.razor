@page "/State/Create"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@using Microsoft.AspNetCore.Antiforgery
@using System.Text.Json
@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAntiforgery Antiforgery
@inject IdentityRedirectManager RedirectManager
@inject IConfiguration _configuration

<PageTitle>State</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Add State</h2>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <EditForm Model="State" OnValidSubmit="FetchAndSaveStateFromApi" FormName="create">
                                <DataAnnotationsValidator />
                                <div class="mb-3">
                                    <label for="statename" class="form-label text-black">State Name:</label>
                                    <InputText id="statename" @bind-Value="State.StateName" class="form-control" />
                                    <ValidationMessage For="() => State.StateName" class="text-danger" />
                                </div>
                                <input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContextAccessor.HttpContext).RequestToken" />
                                <button type="submit" class="btn btn-primary">
                                    <span>Create</span>
                                </button>
                            </EditForm>
                        </div>
                    </div>
                    <br />
                    <div>
                        <a href="/State">Back to List</a>
                    </div>
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/State" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/State" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromForm]
    private State State { get; set; } = new();

    private string ErrorMessage { get; set; }
    private string SuccessMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private bool ShowSuccessModal { get; set; } = false;
    private string SId;

    private async Task FetchAndSaveStateFromApi()
    {
        ErrorMessage = "";
        SuccessMessage = "";
        var LoggedInUser = HttpContextAccessor.HttpContext.Request.Cookies["UserId"];

        try
        {
            using var context = DbFactory.CreateDbContext();
            using var httpClient = new HttpClient();

            SId = _configuration["SId"];

            // Check if the new state is in the local database
            var existingState = await context.State.Where(X => X.CreatedBy == SId || X.CreatedBy == LoggedInUser)
                .FirstOrDefaultAsync(l => EF.Functions.Like(l.StateName, State.StateName));

            if (existingState != null)
            {
                ErrorMessage = $"The state '{State.StateName}' already exists.";
                ShowErrorModal = true;
                return;
            }

            // Add the new state to the database
            var newState = new State
                {
                    StateName = State.StateName,
                    CreatedBy = HttpContextAccessor.HttpContext.Request.Cookies["UserId"],
                    CreatedDateTime = DateTime.Now,
                    UpdatedBy = null,
                    UpdatedDateTime = null,
                    IsActive = true
                };
            context.State.Add(newState);
            await context.SaveChangesAsync();

            // Success message
            SuccessMessage = $"The state '{State.StateName}' has been added successfully.";
            ShowSuccessModal = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
            ShowErrorModal = true;
        }
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        StateHasChanged();
    }
}
