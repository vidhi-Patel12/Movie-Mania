@page "/state/details"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>State</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>State Detail</h2>
                    </div>
                    @if (state is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <dl class="row  text-black">
                            <dt class="col-sm-2">State Name</dt>
                            <dd class="col-sm-10">@state.StateName</dd>
                        </dl>
                        <div>
                            <a href="@($"/State/Edit?stateid={state.StateId}")">Edit</a> |
                            <a href="@($"/State")">Back to List</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    private State? state;

    [SupplyParameterFromQuery]
    private int StateId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        state = await context.State.FirstOrDefaultAsync(m => m.StateId == StateId);

        if (state is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
