@page "/State"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MovieMania.Models
@using MovieMania.Data
@using System.Text.Json

@rendermode @(new InteractiveServerRenderMode(false))

@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject IConfiguration _configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>State</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>State</h2>
                    </div>
                    <div class="row">
                        <div class="col-6"></div>
                        <!-- Search Bar -->
                        <div class="col-4 text-end">
                            <InputText type="search" @bind-value="nameFilter" placeholder="Search" style="height:37px;" @oninput="DebouncedHandleSearch" />
                        </div>
                        <p class="col-2">
                            <a class="btn btn-primary" href="State/Create">Create New</a>
                        </p>
                    </div>

                    <!-- Table with QuickGrid -->
                    <QuickGrid TItem="State" Class="table table-striped" Items="@filteredState.AsQueryable()" Pagination="@pageDetails">
                        <PropertyColumn Property="state => state.StateName" Title="State Name" Sortable="true" />
                        <TemplateColumn Context="state" Title="Action">
                            <a href="@($"state/details?stateid={state.StateId}")"><i class="bi bi-eye-fill" style="color:#29b474"></i></a> &nbsp;
                            @if (state.CreatedBy == LoggedInUser)
                            {
                                <a href="@($"state/edit?stateid={state.StateId}")"><i class="bi bi-pencil-fill" style="color:#2f80ed"></i></a>
                                <span>&nbsp;</span>
                                <a href="/State" @onclick="() => OpenDeleteModal(state.StateId)">
                                    <i class="bi bi-trash-fill" style="color:#eb5757"></i>
                                </a>
                            }
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="@pageDetails" />
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">State Delete</h5>
                <br />
                <p class="text-md-center">Are you sure you want to permanently delete this state?</p>
                <br />
                <div class="row">
                    <div class="col-4"></div>
                    <div class="col-5">
                        @*<a href="/State" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>*@
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>&nbsp;
                        <button type="button" class="btn btn-secondary" @onclick="() => showModal = false">Cancel</button>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/State" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/State" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    string nameFilter = "";
    List<State> filteredState = new List<State>();
    PaginationState pageDetails = new PaginationState { ItemsPerPage = 10 };
    private System.Timers.Timer debounceTimer;

    private bool showModal = false;
    private int? selectedStateId;

    private string ErrorMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private string SuccessMessage { get; set; }
    private bool ShowSuccessModal { get; set; } = false;

    private string SId;
    private string LoggedInUser;

    private void DebouncedHandleSearch(ChangeEventArgs e)
    {
        nameFilter = e.Value?.ToString();

        // Reset the timer
        debounceTimer?.Stop();
        debounceTimer = new System.Timers.Timer(100); // 100ms debounce
        debounceTimer.Elapsed += async (_, _) => await InvokeAsync(HandleSearch);
        debounceTimer.Start();
    }

    private async Task HandleSearch()
    {
        debounceTimer?.Stop();
        var context = DbFactory.CreateDbContext();
        if (!string.IsNullOrWhiteSpace(nameFilter))
        {
            filteredState = await context.State
                                        .Where(x => EF.Functions.Like(
                                            EF.Functions.Collate(x.StateName, "SQL_Latin1_General_CP1_CI_AS"),
                                            $"%{nameFilter}%"))
                                        .ToListAsync();
        }
        else
        {
            SId = _configuration["SId"];
            LoggedInUser = _configuration["LoggedInUserId"];

            if (LoggedInUser == SId)
            {
                filteredState = await context.State
                                        .Where(X => X.CreatedBy == SId && X.IsActive == true)
                                        .OrderByDescending(x => x.StateId)
                                        .ToListAsync();
                // If filteredState is still empty (no data in the database), fetch from the API
                if (!filteredState.Any())
                {
                    using var httpClient = new HttpClient();

                    // Fetch data from API
                    var response = await httpClient.GetAsync("https://countriesnow.space/api/v0.1/countries/states");
                    response.EnsureSuccessStatusCode();

                    // Read response as string
                    var jsonString = await response.Content.ReadAsStringAsync();
                    Console.WriteLine(jsonString); // Debugging log

                    List<State> apiState = new();

                    using (var doc = JsonDocument.Parse(jsonString))
                    {
                        var root = doc.RootElement;
                        if (root.TryGetProperty("data", out var dataElement) && dataElement.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var country in dataElement.EnumerateArray())
                            {
                                if (country.TryGetProperty("name", out var countryNameElement) &&
                                    country.TryGetProperty("states", out var statesElement) &&
                                    statesElement.ValueKind == JsonValueKind.Array)
                                {
                                    string countryName = countryNameElement.GetString()?.ToLower(); // Convert to lowercase

                                    // Find the corresponding CountryId from the database
                                    var countryData = await context.Country
                                                        .Where(c => c.CountryName.ToLower() == countryName)
                                                        .Select(c => new { c.CountryId, c.CountryName })
                                                        .FirstOrDefaultAsync();

                                    if (countryData != null)
                                    {
                                        foreach (var state in statesElement.EnumerateArray())
                                        {
                                            if (state.TryGetProperty("name", out var stateNameElement))
                                            {
                                                string stateName = stateNameElement.GetString();
                                                if (!string.IsNullOrWhiteSpace(stateName))
                                                {
                                                    // Check if state already exists in the database
                                                    bool exists = await context.State.AnyAsync(s => s.StateName == stateName);
                                                    if (!exists)
                                                    {
                                                        apiState.Add(new State
                                                            {
                                                                StateName = stateName,
                                                                CountryId = countryData.CountryId, // Assign CountryId
                                                                CreatedBy = LoggedInUser,
                                                                CreatedDateTime = DateTime.Now,
                                                                UpdatedBy = null,
                                                                UpdatedDateTime = null,
                                                                IsActive = true
                                                            });
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        else
                        {
                            // Handle error if the data format is incorrect
                            ErrorMessage = "Invalid data.";
                            ShowErrorModal = true;
                            return;
                        }
                    }

                    // Check if the state list is not empty after fetching the API data
                    if (apiState.Any())
                    {
                        // Get existing states from the database
                        var existingStateNames = await context.State
                            .Select(x => x.StateName.ToLower())
                            .ToListAsync();

                        // Fetch country data from the database
                        var countryDictionary = await context.Country
                            .ToDictionaryAsync(c => c.CountryName.ToLower(), c => c.CountryId);

                        List<State> statesToInsert = new();

                        foreach (var state in apiState)
                        {
                            string stateName = state.StateName;
                            //string countryName = state.CountryName?.ToLower(); // Ensure it's nullable safe

                            string countryName = await context.Country.Where(c => c.CountryId == state.CountryId).Select(c => c.CountryName).FirstOrDefaultAsync();


                            if (!existingStateNames.Contains(stateName.ToLower()))
                            {
                                if (countryDictionary.TryGetValue(countryName, out int countryId))
                                {
                                    // Add new state with the correct CountryId
                                    statesToInsert.Add(new State
                                        {
                                            StateName = stateName,
                                            CountryId = countryId,  // Assign CountryId dynamically
                                            CreatedBy = LoggedInUser,
                                            CreatedDateTime = DateTime.Now,
                                            UpdatedBy = null,
                                            UpdatedDateTime = null,
                                            IsActive = true
                                        });
                                }
                                else
                                {
                                    // Handle case where country does not exist in the database
                                    Console.WriteLine($"Country '{countryName}' not found in database.");
                                }
                            }
                        }

                        // Perform insert operation
                        if (statesToInsert.Any())
                        {
                            await context.State.AddRangeAsync(statesToInsert);
                            await context.SaveChangesAsync();
                        }

                        // Reload filtered data from the database
                        filteredState = await context.State
                            .Where(x => x.CreatedBy == SId && x.IsActive == true)
                            .OrderByDescending(x => x.StateId)
                            .ToListAsync();
                    }

                }
            }

            else
            {
                filteredState = await context.State
                     .Where(x => (x.CreatedBy == SId || x.CreatedBy == LoggedInUser) && x.IsActive == true)
                    .OrderByDescending(x => x.StateId)
                    .ToListAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await HandleSearch();
    }

    private void OpenDeleteModal(int stateId)
    {
        // Set the selected state ID and open the modal
        selectedStateId = stateId;
        showModal = true;
    }

    private void ConfirmDelete()
    {
        if (selectedStateId != null)
        {
            // Call your delete logic here
            DeleteState(selectedStateId.Value);
            showModal = false;
        }
    }

    private async Task DeleteState(int stateId)
    {
        using var context = DbFactory.CreateDbContext();

        if (string.IsNullOrEmpty(LoggedInUser))
        {
            // Handle case where UserId cookie is not present
            Console.WriteLine("UserId cookie not found.");
            return;
        }

        // Find the state by ID
        var state = await context.State.FirstOrDefaultAsync(lang => lang.StateId == stateId);

        if (state == null)
        {
            // Handle case where the state does not exist
            Console.WriteLine($"State with ID {stateId} not found.");
            return;
        }

        state.IsActive = false;
        state.UpdatedBy = LoggedInUser;
        state.UpdatedDateTime = DateTime.Now;

        // Attach the entity and mark it as modified
        context.Attach(state).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
            showModal = false;
            await HandleSearch();
            StateHasChanged();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!StateExists(state.StateId))
            {
                // Navigate to not found page if the state does not exist
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
        NavigationManager.NavigateTo("/State");
    }

    private bool StateExists(int stateId)
    {
        using var context = DbFactory.CreateDbContext();
        return context.State.Any(e => e.StateId == stateId);
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        StateHasChanged();
    }
}