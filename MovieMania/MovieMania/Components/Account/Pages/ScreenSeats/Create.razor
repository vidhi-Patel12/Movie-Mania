@page "/ScreenSeats/Create"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@using Microsoft.AspNetCore.Antiforgery
@using System.Text.Json
@using System.Globalization

@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IAntiforgery Antiforgery
@inject IdentityRedirectManager RedirectManager
@inject IConfiguration _configuration

@rendermode @(new InteractiveServerRenderMode(false))

<PageTitle>ScreenSeats</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Add Screen Seats</h2>
                    </div>
                    <EditForm Model="ScreenSeats" OnValidSubmit="FetchAndSaveScreenSeats" FormName="create">
                        <DataAnnotationsValidator />
                        <div class="row">
                            <div class="col-6">
                                <div class="col-mb-3">
                                    <div>
                                        <label for="ScreenId" class="form-label text-black">Screen Name</label>
                                    </div>
                                    <InputSelect @bind-Value="SelectedCinemaId" class="form-control" @oninput="OnCinemaChanged">
                                        <option value="">Select Cinema</option>
                                        @foreach (var cinema in Cinemas)
                                        {
                                            <option value="@cinema.CinemaId">
                                                @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(cinema.CinemaName.ToLower())
                                            </option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => ScreenSeats.ScreenId" class="text-danger" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="col-mb-3">
                                    <div>
                                        <label for="ScreenId" class="form-label text-black">Screen Name</label>
                                    </div>
                                    <InputSelect @bind-Value="ScreenSeats.ScreenId" class="form-control">
                                        <option value="">Select Screen</option>
                                        @foreach (var screen in Screens)
                                        {
                                            <option value="@screen.ScreenId">
                                                @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(screen.ScreenName.ToLower())
                                            </option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => ScreenSeats.ScreenId" class="text-danger" />
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-6">
                                <div class="col-mb-3">
                                    <div>
                                        <label for="SeatTypeId" class="form-label text-black">SeatType Name</label>
                                    </div>
                                    <InputSelect @bind-Value="ScreenSeats.SeatTypeId" class="form-control" @oninput="OnSeatTypeChanged">
                                        <option value="">Select SeatType</option>
                                        @foreach (var seattype in SeatTypes)
                                        {
                                            <option value="@seattype.SeatTypeId">@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(seattype.SeatTypeName.ToLower())</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => ScreenSeats.SeatTypeId" class="text-danger" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mb-3">
                                    <label for="totalSeats" class="form-label text-black">TotalSeats</label>
                                    <InputNumber id="totalSeats" @bind-Value="ScreenSeats.TotalSeats" class="form-control" />
                                    <ValidationMessage For="() => ScreenSeats.TotalSeats" class="text-danger" />
                                </div>
                            </div>
                        </div>
                        <input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContextAccessor.HttpContext).RequestToken" />
                        <div class="row">
                            <div class="col-6">
                                <button type="submit" class="btn btn-primary">
                                    <span>Create</span>
                                </button>
                                <div>
                                    <a href="/ScreenSeats">Back to List</a>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                    <br />
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/ScreenSeats" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/ScreenSeats" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromForm]
    private ScreenSeats ScreenSeats { get; set; } = new();

    private List<SeatType> SeatTypes { get; set; } = new();
    private List<Screen> Screens { get; set; } = new();
    private List<Screen> FilteredScreens { get; set; } = new();

    private int? SelectedCinemaId { get; set; }
    private List<Cinema> Cinemas { get; set; } = new();

    private string SelectedSeatTypeName { get; set; } = string.Empty;
    private int selectedSeatType;

    private string SelectedScreenName { get; set; } = string.Empty;
    private int selectedScreen;

    private string SelectedCinemaName { get; set; } = string.Empty;
    private int selectedCinema;

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private bool ShowSuccessModal { get; set; } = false;
    private string? SId;
    private string? LoggedInUser;

    protected override async Task OnInitializedAsync()
    {
        await LoadSeatTypes();
        await LoadCinemas();
    }

    private async Task LoadScreens(int cinemaId)
    {
        using var context = DbFactory.CreateDbContext();

        Screens = await context.Screen
            .Where(s => s.CinemaId == cinemaId)
            .ToListAsync();
    }


    private async Task LoadSeatTypes()
    {
        using var context = DbFactory.CreateDbContext();
        SeatTypes = await context.SeatType.ToListAsync();
    }

    private async Task LoadCinemas()
    {
        using var context = DbFactory.CreateDbContext();

        // Fetch Cinemas that have at least one screen
        Cinemas = await context.Cinema
            .Where(c => context.Screen.Any(s => s.CinemaId == c.CinemaId))
            .ToListAsync();
    }

    private async Task OnCinemaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cinemaId))
        {
            SelectedCinemaId = cinemaId;
            await LoadScreens(cinemaId); // Load Screens for selected cinema
        }
        else
        {
            SelectedCinemaId = null;
            Screens.Clear();
        }
    }

    private async Task OnScreenChanged(ChangeEventArgs e)
    {
        if (e.Value != null && int.TryParse(e.Value.ToString(), out var screenId))
        {
            ScreenSeats.ScreenId = screenId;
        }
    }

    private async Task OnSeatTypeChanged(ChangeEventArgs e)
    {
        if (e.Value != null && int.TryParse(e.Value.ToString(), out var seattypeId))
        {
            ScreenSeats.SeatTypeId = seattypeId;

        }
    }

    private async Task FetchAndSaveScreenSeats()
    {
        ErrorMessage = "";
        SuccessMessage = "";
        LoggedInUser = _configuration["LoggedInUserId"];

        try
        {
            using var context = DbFactory.CreateDbContext();
            using var httpClient = new HttpClient();

            SId = _configuration["SId"];

            // Check if the new ScreenSeats is in the local database
            var existingScreenSeats = await context.ScreenSeats
             .Where(x => (x.CreatedBy == SId || x.CreatedBy == LoggedInUser)
                         && x.ScreenId == ScreenSeats.ScreenId
                         && x.SeatTypeId == ScreenSeats.SeatTypeId)
             .FirstOrDefaultAsync();

            if (existingScreenSeats != null)
            {
                ErrorMessage = $"The screenseats '{ScreenSeats.SeatTypeId}' already exists.";
                ShowErrorModal = true;
                return;
            }

            // Fetch the total allowed seats for the given ScreenId
            var screen = await context.Screen
             .Where(s => s.ScreenId == ScreenSeats.ScreenId)
             .FirstOrDefaultAsync();

            if (screen == null)
            {
                ErrorMessage = $"Screen not found.";
                ShowErrorModal = true;
                return;
            }

            // Calculate the total seats already assigned in ScreenSeats for this ScreenId
            var totalAssignedSeats = await context.ScreenSeats
                .Where(ss => ss.ScreenId == ScreenSeats.ScreenId)
                .SumAsync(ss => ss.TotalSeats);

            // Calculate the new total if we add this new seat entry
            var newTotalSeats = totalAssignedSeats + ScreenSeats.TotalSeats;

            // Check if it exceeds the total seats available in the Screen table
            if (newTotalSeats > screen.TotalSeats)
            {
                ErrorMessage = $"Total seats cannot exceed {screen.TotalSeats}. " +
                                  $"Currently assigned: {totalAssignedSeats}, " +
                                  $"Trying to add: {ScreenSeats.TotalSeats}, " +
                                  $"Maximum allowed: {screen.TotalSeats}";
                ShowErrorModal = true;
                return;
            }

            // Add the new ScreenSeats to the database
            var newScreenSeats = new ScreenSeats
                {
                    ScreenId = ScreenSeats.ScreenId,
                    SeatTypeId = ScreenSeats.SeatTypeId,
                    TotalSeats = ScreenSeats.TotalSeats,
                    CreatedBy = LoggedInUser,
                    CreatedDateTime = DateTime.Now,
                    UpdatedBy = null,
                    UpdatedDateTime = null,
                    IsActive = true
                };
            context.ScreenSeats.Add(newScreenSeats);
            await context.SaveChangesAsync();
                     
            SuccessMessage = $"The screenseats has been added successfully.";
            ShowSuccessModal = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
            ShowErrorModal = true;
        }
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        NavigationManager.NavigateTo("/ScreenSeats");
    }
}