@page "/MovieScreen"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MovieMania.Models
@using MovieMania.Data
@using System.Text.Json

@rendermode @(new InteractiveServerRenderMode(false))

@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject IConfiguration _configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>MovieScreen</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Movie Screen</h2>
                    </div>
                    <div class="row">
                        <div class="col-6"></div>
                        <div class="col-4 text-end">
                            <InputText type="search" @bind-value="nameFilter" placeholder="Search" style="height:37px;" @oninput="DebouncedHandleSearch" />
                        </div>
                        <p class="col-2">
                            <a class="btn btn-primary" href="MovieScreen/Create">Create New</a>
                        </p>
                    </div>

                    <QuickGrid TItem="MovieScreen" Class="table table-striped" Items="@filteredMovieScreen.AsQueryable()" Pagination="@pageDetails">
                        <TemplateColumn Context="moviescreen" Title="Cinema">
                            <p>@CapitalizeFirstLetter(GetCinemaName(moviescreen.CinemaId))</p>
                        </TemplateColumn>

                        <TemplateColumn Context="moviescreen" Title="Screen Name">
                            <p>@CapitalizeFirstLetter(GetScreenName(moviescreen.ScreenId))</p>
                        </TemplateColumn>
                        <TemplateColumn Context="moviescreen" Title="Movie Name">
                            <p>@CapitalizeFirstLetter(GetMovieName(moviescreen.MovieId))</p>
                        </TemplateColumn>

                        <TemplateColumn Context="moviescreen" Title="Start Time">
                            <p>@moviescreen.StartTime</p>
                        </TemplateColumn>
                        <TemplateColumn Context="moviescreen" Title="End Time">
                            <p>@moviescreen.EndTime</p>
                        </TemplateColumn>

                        <TemplateColumn Context="moviescreen" Title="Action">
                            <a href="@($"MovieScreen/Details?moviescreenid={moviescreen.MovieScreenId}")"><i class="bi bi-eye-fill" style="color:#29b474"></i></a> &nbsp;
                            @if (moviescreen.CreatedBy == LoggedInUser)
                            {
                                <a href="@($"MovieScreen/Edit?moviescreenid={moviescreen.MovieScreenId}")"><i class="bi bi-pencil-fill" style="color:#2f80ed"></i></a>
                                <span>&nbsp;</span>
                                <a href="/MovieScreen" @onclick="() => OpenDeleteModal(moviescreen.MovieScreenId)">
                                    <i class="bi bi-trash-fill" style="color:#eb5757"></i>
                                </a>
                            }
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="@pageDetails" />
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">MovieScreen Delete</h5>
                <br />
                <p class="text-md-center">Are you sure you want to permanently delete this moviescreen?</p>
                <br />
                <div class="row">
                    <div class="col-4"></div>
                    <div class="col-5">
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>&nbsp;
                        <button type="button" class="btn btn-secondary" @onclick="() => showModal = false">Cancel</button>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/MovieScreen" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/MovieScreen" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    string nameFilter = "";
    List<MovieScreen> filteredMovieScreen = new List<MovieScreen>();
    PaginationState pageDetails = new PaginationState { ItemsPerPage = 10 };
    private System.Timers.Timer? debounceTimer;

    private bool showModal = false;
    private int? selectedMovieScreenId;

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private bool ShowSuccessModal { get; set; } = false;
    private string? SId;
    private string? LoggedInUser;

    private Dictionary<int, string> cinemaLookup = new();
    private Dictionary<int, string> screenLookup = new();
    private Dictionary<int, string> movieLookup = new();

    protected override async Task OnInitializedAsync()
    {
        await HandleSearch();
        await LoadLookups();
    }

    private void DebouncedHandleSearch(ChangeEventArgs e)
    {
        nameFilter = e.Value?.ToString();

        // Reset the timer
        debounceTimer?.Stop();
        debounceTimer = new System.Timers.Timer(100); // 100ms debounce
        debounceTimer.Elapsed += async (_, _) => await InvokeAsync(HandleSearch);
        debounceTimer.Start();
    }

    private async Task HandleSearch()
    {
        debounceTimer?.Stop();
        var context = DbFactory.CreateDbContext();
        if (!string.IsNullOrWhiteSpace(nameFilter))
        {
            filteredMovieScreen = await context.MovieScreen
     .Include(ms => ms.Movie)
     .Where(ms => EF.Functions.Like(
         EF.Functions.Collate(ms.Movie.MovieName, "SQL_Latin1_General_CP1_CI_AS"),
         $"%{nameFilter}%"))
     .ToListAsync();

        }
        else
        {
            SId = _configuration["SId"];
            LoggedInUser = _configuration["LoggedInUserId"];

            if (LoggedInUser == SId)
            {
                filteredMovieScreen = await context.MovieScreen
                                        .Where(X => X.CreatedBy == SId && X.IsActive == true)
                                        .OrderByDescending(x => x.MovieScreenId)
                                        .ToListAsync();
            }
            else
            {
                filteredMovieScreen = await context.MovieScreen
                     .Where(x => (x.CreatedBy == SId || x.CreatedBy == LoggedInUser) && x.IsActive == true)
                    .OrderByDescending(x => x.MovieScreenId)
                    .ToListAsync();
            }
        }
    }

    private async Task LoadLookups()
    {
        using var context = DbFactory.CreateDbContext();

        var cinemas = await context.Cinema.ToListAsync(); // Fix: Use ToListAsync()
        cinemaLookup = cinemas.ToDictionary(c => c.CinemaId, c => c.CinemaName);

        var screens = await context.Screen.ToListAsync(); // Fix: Use ToListAsync()
        screenLookup = screens.ToDictionary(c => c.ScreenId, c => c.ScreenName);

        var movies = await context.Movies.ToListAsync(); // Fix: Use ToListAsync()
        movieLookup = movies.ToDictionary(c => c.MovieId, c => c.MovieName);

    }

    private string GetCinemaName(int cinemaId)
    {
        return cinemaLookup.TryGetValue(cinemaId, out var name) ? name : "Unknown";
    }
    private string GetScreenName(int screenId)
    {
        return screenLookup.TryGetValue(screenId, out var name) ? name : "Unknown";
    }
    private string GetMovieName(int movieId)
    {
        return movieLookup.TryGetValue(movieId, out var name) ? name : "Unknown";
    }

    public string CapitalizeFirstLetter(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return input;
        }

        return char.ToUpper(input[0]) + input.Substring(1).ToLower();
    }

    private void OpenDeleteModal(int moviescreenId)
    {
        // Set the selected MovieScreen ID and open the modal
        selectedMovieScreenId = moviescreenId;
        showModal = true;
    }

    private void ConfirmDelete()
    {
        if (selectedMovieScreenId != null)
        {
            // Call your delete logic here
            DeleteMovieScreen(selectedMovieScreenId.Value);
            showModal = false;
        }
    }

    private async Task DeleteMovieScreen(int moviescreenId)
    {
        using var context = DbFactory.CreateDbContext();

        if (string.IsNullOrEmpty(LoggedInUser))
        {
            // Handle case where UserId cookie is not present
            Console.WriteLine("UserId cookie not found.");
            return;
        }

        var moviescreen = await context.MovieScreen.FirstOrDefaultAsync(moviescreen => moviescreen.MovieScreenId == moviescreenId);

        if (moviescreen == null)
        {
            Console.WriteLine($"MovieScreen with ID {moviescreenId} not found.");
            return;
        }

        moviescreen.IsActive = false;
        moviescreen.UpdatedBy = LoggedInUser;
        moviescreen.UpdatedDateTime = DateTime.Now;

        context.Attach(moviescreen).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
            showModal = false;
            await HandleSearch();
            StateHasChanged();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!MovieScreenExists(moviescreen.MovieScreenId))
            {
                // Navigate to not found page if the MovieScreen does not exist
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
        NavigationManager.NavigateTo("/MovieScreen");
    }

    private bool MovieScreenExists(int moviescreenId)
    {
        using var context = DbFactory.CreateDbContext();
        return context.MovieScreen.Any(e => e.MovieScreenId == moviescreenId);
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        StateHasChanged();
    }
}