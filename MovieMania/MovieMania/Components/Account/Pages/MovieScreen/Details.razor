@page "/MovieScreen/Details"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>MovieScreen</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>Movie Screen Detail</h2>
                    </div>
                    @if (moviescreen is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <dl class="row text-black">
                            <dt class="col-sm-2">Cinema</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(cinemaName)</dd>
                        </dl>
                        <dl class="row  text-black">
                            <dt class="col-sm-2">Screen Name</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(screenName)</dd>
                        </dl>                       

                        <dl class="row  text-black">
                            <dt class="col-sm-2">Movie Name</dt>
                            <dd class="col-sm-10">@CapitalizeFirstLetter(movieName)</dd>
                        </dl>

                        <dl class="row  text-black">
                            <dt class="col-sm-2">Start Time</dt>
                            <dd class="col-sm-10">@moviescreen.StartTime</dd>
                        </dl>
                        <dl class="row  text-black">
                            <dt class="col-sm-2">End Time</dt>
                            <dd class="col-sm-10">@moviescreen.EndTime</dd>
                        </dl>
                        <div>
                            <a href="@($"/MovieScreen/Edit?moviescreenid={moviescreen.MovieScreenId}")">Edit</a> |
                            <a href="@($"/MovieScreen")">Back to List</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    private MovieScreen? moviescreen;

    [SupplyParameterFromQuery]
    private int MovieScreenId { get; set; }

    private string cinemaName = string.Empty;
     private string screenName = string.Empty;
    private string movieName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        moviescreen = await context.MovieScreen.FirstOrDefaultAsync(m => m.MovieScreenId == MovieScreenId);

        if (moviescreen is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        var cinema = await context.Cinema.FirstOrDefaultAsync(c => c.CinemaId == moviescreen.CinemaId);

        cinemaName = cinema?.CinemaName ?? "N/A";

        var screen = await context.Screen.FirstOrDefaultAsync(c => c.ScreenId == moviescreen.ScreenId);

        screenName = screen?.ScreenName ?? "N/A";

        var movie = await context.Movies.FirstOrDefaultAsync(c => c.MovieId == moviescreen.MovieId);

        movieName = movie?.MovieName ?? "N/A";
    }

    public string CapitalizeFirstLetter(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return input;
        }
        return char.ToUpper(input[0]) + input.Substring(1).ToLower();
    }
}
