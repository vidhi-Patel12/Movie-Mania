@page "/City"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MovieMania.Models
@using MovieMania.Data
@using System.Text.Json

@rendermode @(new InteractiveServerRenderMode(false))

@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject IConfiguration _configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>City</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>City</h2>
                    </div>
                    <div class="row">
                        <div class="col-6"></div>
                        <!-- Search Bar -->
                        <div class="col-4 text-end">
                            <InputText type="search" @bind-value="nameFilter" placeholder="Search" style="height:37px;" @oninput="DebouncedHandleSearch" />
                        </div>
                        <p class="col-2">
                            <a class="btn btn-primary" href="City/Create">Create New</a>
                        </p>
                    </div>

                    <!-- Table with QuickGrid -->
                    <QuickGrid TItem="City" Class="table table-striped" Items="@filteredCity.AsQueryable()" Pagination="@pageDetails">
                        <PropertyColumn Property="city => city.CityName" Title="City Name" Sortable="true" />
                        <TemplateColumn Context="city" Title="Action">
                            <a href="@($"city/details?cityid={city.CityId}")"><i class="bi bi-eye-fill" style="color:#29b474"></i></a> &nbsp;
                            @if (city.CreatedBy == LoggedInUser)
                            {
                                <a href="@($"city/edit?cityid={city.CityId}")"><i class="bi bi-pencil-fill" style="color:#2f80ed"></i></a>
                                <span>&nbsp;</span>
                                <a href="/City" @onclick="() => OpenDeleteModal(city.CityId)">
                                    <i class="bi bi-trash-fill" style="color:#eb5757"></i>
                                </a>
                            }
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="@pageDetails" />
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">City Delete</h5>
                <br />
                <p class="text-md-center">Are you sure you want to permanently delete this city?</p>
                <br />
                <div class="row">
                    <div class="col-4"></div>
                    <div class="col-5">
                        @*<a href="/City" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>*@
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>&nbsp;
                        <button type="button" class="btn btn-secondary" @onclick="() => showModal = false">Cancel</button>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowErrorModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-error-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Error</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@ErrorMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/City" class="btn btn-secondary" @onclick="CloseErrorModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@if (ShowSuccessModal)
{
    <div class="modal fade show" tabindex="-1" aria-labelledby="modal-success-label" aria-modal="true" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#151f30; vertical-align: middle; margin-top: 50%; max-width: 420px;">
                <br />
                <h5 class="modal-title text-md-center text-white">Success</h5>
                <br />
                <div class="text-md-center text-white">
                    <p>@SuccessMessage</p>
                </div>
                <div class="row">
                    <div class="col-5"></div>
                    <div class="col-5">
                        <a href="/City" class="btn btn-secondary" @onclick="CloseSuccessModal">Ok</a>
                    </div>
                    <div class="col-2"></div>
                    <br />
                </div>
                <br />
            </div>
        </div>
    </div>
}

@code {
    string nameFilter = "";
    List<City> filteredCity = new List<City>();
    PaginationState pageDetails = new PaginationState { ItemsPerPage = 10 };
    private System.Timers.Timer debounceTimer;

    private bool showModal = false;
    private int? selectedCityId;

    private string ErrorMessage { get; set; }
    private bool ShowErrorModal { get; set; } = false;
    private string SuccessMessage { get; set; }
    private bool ShowSuccessModal { get; set; } = false;

    private string SId;
    private string LoggedInUser;

    private void DebouncedHandleSearch(ChangeEventArgs e)
    {
        nameFilter = e.Value?.ToString();

        // Reset the timer
        debounceTimer?.Stop();
        debounceTimer = new System.Timers.Timer(100); // 100ms debounce
        debounceTimer.Elapsed += async (_, _) => await InvokeAsync(HandleSearch);
        debounceTimer.Start();
    }

    private async Task HandleSearch()
    {
        debounceTimer?.Stop();
        var context = DbFactory.CreateDbContext();
        if (!string.IsNullOrWhiteSpace(nameFilter))
        {
            filteredCity = await context.City
                                        .Where(x => EF.Functions.Like(
                                            EF.Functions.Collate(x.CityName, "SQL_Latin1_General_CP1_CI_AS"),
                                            $"%{nameFilter}%"))
                                        .ToListAsync();
        }
        else
        {
            SId = _configuration["SId"];
            LoggedInUser = _configuration["LoggedInUserId"];

            if (LoggedInUser == SId)
            {
                filteredCity = await context.City
                                        .Where(X => X.CreatedBy == SId && X.IsActive == true)
                                        .OrderByDescending(x => x.CityId)
                                        .ToListAsync();
                // If filteredCity is still empty (no data in the database), fetch from the API
                if (!filteredCity.Any())
                {
                    using var httpClient = new HttpClient();

                    // Fetch data from API
                    var response = await httpClient.GetAsync("https://countriesnow.space/api/v0.1/countries");
                    response.EnsureSuccessStatusCode();

                    // Read response as string
                    var jsonString = await response.Content.ReadAsStringAsync();
                    Console.WriteLine(jsonString); // Debugging log

                    List<State> apiState = new();
                    List<City> apiCities = new();  // For storing cities

                    using (var doc = JsonDocument.Parse(jsonString))
                    {
                        var root = doc.RootElement;
                        if (root.TryGetProperty("data", out var dataElement) && dataElement.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var country in dataElement.EnumerateArray())
                            {
                                if (country.TryGetProperty("country", out var countryNameElement) &&
                                    country.TryGetProperty("cities", out var citiesElement) &&
                                    citiesElement.ValueKind == JsonValueKind.Array)
                                {
                                    string countryName = countryNameElement.GetString()?.ToLower(); // Convert to lowercase

                                    // Find the corresponding CountryId from the database
                                    var countryData = await context.Country
                                        .Where(c => c.CountryName.ToLower() == countryName)
                                        .Select(c => new { c.CountryId, c.CountryName })
                                        .FirstOrDefaultAsync();

                                    if (countryData != null)
                                    {
                                        // Find states corresponding to the country
                                        var states = await context.State
                                            .Where(s => s.CountryId == countryData.CountryId)
                                            .ToListAsync();

                                        foreach (var state in states)
                                        {
                                            // For each state, find cities from the API
                                            foreach (var cityName in citiesElement.EnumerateArray())
                                            {
                                                string city = cityName.GetString();
                                                if (!string.IsNullOrWhiteSpace(city))
                                                {
                                                    bool cityExists = await context.City
                                                        .AnyAsync(c => c.CityName == city && c.StateId == state.StateId);

                                                    if (!cityExists)
                                                    {
                                                        apiCities.Add(new City
                                                            {
                                                                CityName = city,
                                                                StateId = state.StateId, // Assign the matched StateId
                                                                CreatedBy = LoggedInUser,
                                                                CreatedDateTime = DateTime.Now,
                                                                IsActive = true
                                                            });
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        else
                        {
                            // Handle error if the data format is incorrect
                            ErrorMessage = "Invalid data.";
                            ShowErrorModal = true;
                            return;
                        }
                    }

                    // Insert new cities
                    if (apiCities.Any())
                    {
                        await context.City.AddRangeAsync(apiCities);
                        await context.SaveChangesAsync();
                    }

                    // Refresh filtered cities
                    filteredCity = await context.City
                        .Where(x => x.CreatedBy == SId && x.IsActive == true)
                        .OrderByDescending(x => x.CityId)
                        .ToListAsync();
                }

            }

            else
            {
                filteredCity = await context.City
                     .Where(x => (x.CreatedBy == SId || x.CreatedBy == LoggedInUser) && x.IsActive == true)
                    .OrderByDescending(x => x.CityId)
                    .ToListAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await HandleSearch();
    }

    private void OpenDeleteModal(int cityId)
    {
        // Set the selected state ID and open the modal
        selectedCityId = cityId;
        showModal = true;
    }

    private void ConfirmDelete()
    {
        if (selectedCityId != null)
        {
            // Call your delete logic here
            DeleteCity(selectedCityId.Value);
            showModal = false;
        }
    }

    private async Task DeleteCity(int cityId)
    {
        using var context = DbFactory.CreateDbContext();

        if (string.IsNullOrEmpty(LoggedInUser))
        {
            // Handle case where UserId cookie is not present
            Console.WriteLine("UserId cookie not found.");
            return;
        }

        // Find the city by ID
        var city = await context.City.FirstOrDefaultAsync(lang => lang.CityId == cityId);

        if (city == null)
        {
            // Handle case where the city does not exist
            Console.WriteLine($"City with ID {cityId} not found.");
            return;
        }

        city.IsActive = false;
        city.UpdatedBy = LoggedInUser;
        city.UpdatedDateTime = DateTime.Now;

        // Attach the entity and mark it as modified
        context.Attach(city).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
            showModal = false;
            await HandleSearch();
            StateHasChanged();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!CityExists(city.CityId))
            {
                // Navigate to not found page if the city does not exist
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
        NavigationManager.NavigateTo("/City");
    }

    private bool CityExists(int cityId)
    {
        using var context = DbFactory.CreateDbContext();
        return context.City.Any(e => e.CityId == cityId);
    }

    private void CloseErrorModal()
    {
        ShowErrorModal = false;
    }

    private void CloseSuccessModal()
    {
        ShowSuccessModal = false;
        StateHasChanged();
    }
}