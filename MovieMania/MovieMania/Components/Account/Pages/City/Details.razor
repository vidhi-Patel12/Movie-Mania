@page "/city/details"
@using Microsoft.EntityFrameworkCore
@using MovieMania.Models
@inject IDbContextFactory<MovieMania.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>City</PageTitle>

<div class="vh-100" style="margin-top:5%;">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="card shadow">
                <div class="card-body" style="background-color: lightgray;">
                    <div class="row text-black">
                        <h2>City Detail</h2>
                    </div>
                    @if (city is null)
                    {
                        <p><em>No Data Available...</em></p>
                    }
                    else
                    {
                        <dl class="row  text-black">
                            <dt class="col-sm-2">City Name</dt>
                            <dd class="col-sm-10">@city.CityName</dd>
                        </dl>
                        <div>
                            <a href="@($"/City/Edit?cityid={city.CityId}")">Edit</a> |
                            <a href="@($"/City")">Back to List</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    private City? city;

    [SupplyParameterFromQuery]
    private int CityId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        city = await context.City.FirstOrDefaultAsync(m => m.CityId == CityId);

        if (city is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
